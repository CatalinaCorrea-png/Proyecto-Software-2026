# ====================================================================
# AeroSearch AI — variables de entorno (PLANTILLA)
#
# Copiá este archivo a `.env` y completá los valores:
#     cp .env.example .env
#
# ====================================================================

# --- Roboflow (solo lo usan los scripts de training/) -----------------
ROBOFLOW_API_KEY=tu_api_key_aca
ROBOFLOW_WORKSPACE=nicolas-cernadas
ROBOFLOW_PROJECT=detecciones-unsam

# --- Fuente de cámara -------------------------------------------------
# Opciones: webcam | camo | esp32 | video | synthetic
CAMERA_SOURCE=video
# Si CAMERA_SOURCE=video: archivo/carpeta de videos (el loop reproduce
# en bucle los videos de esa carpeta).
VIDEO_SOURCE=media/videos/unsam/unsam_drone_view_1.mp4

# --- Modelo de detección ----------------------------------------------
# Ruta al .pt, relativa a backend/ o absoluta. Alternar acá sin tocar código:
#   v2:  yolov8n_tuned_v2.pt
#   v3:  yolov8n_tuned_v3.pt
YOLO_WEIGHTS=yolov8n_tuned_v3.pt
# Tamaño de inferencia: 1280 = más preciso en tomas aéreas (26%->72% en el
# diagnóstico); 640 = mas rapido. Las detecciones son
# idénticas en cualquier máquina a un mismo imgsz; solo cambia la velocidad.
YOLO_IMGSZ=1280

# --- MongoDB ----------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=aerosearch

# --- Dron / ESP32 (solo si usás el hardware real) ---------------------
DRONE_IP=192.168.4.1
DRONE_UDP_PORT=4210
DRONE_UDP_TX_PORT=4211
