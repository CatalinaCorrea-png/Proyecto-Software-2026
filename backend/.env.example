# Copiá este archivo como .env y completá los valores para tu entorno
# cp .env.example .env

# Fuente de video: webcam | camo | esp32 | video | synthetic
CAMERA_SOURCE=webcam

# Rotar imagen 180° (cámara montada al revés)
# CAMERA_FLIP=1

# Requerido solo si CAMERA_SOURCE=esp32
# DRONE_IP=192.168.x.x
# ESP32_STREAM_URL=http://192.168.x.x/stream

# Archivo de video (usado si CAMERA_SOURCE=video)
# VIDEO_SOURCE=media/videos/video6.mp4

# Puertos UDP del drone (deben coincidir con el firmware)
# DRONE_UDP_PORT=4210
# DRONE_UDP_TX_PORT=4211

# MongoDB (solo si no usás Docker o necesitás autenticación)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB=aerosearch

# Apidrone API (driver opcional)
# Cuando está definida, los comandos de control se envían a Apidrone en lugar de UDP directo.
# CAMERA_SOURCE=apidrone habilita el video desde /mjpeg de Apidrone.
# APIDRONE_API_URL=http://localhost:8001
